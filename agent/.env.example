NEGOCIO=REEMPLAZAR_POR_EL_NOMBRE_EXACTO
OWNER=REEMPLAZAR_POR_LA_WALLET_PUBLICA_DEL_REGISTRO
RPC_URL=https://api.devnet.solana.com

LLM_MODE=online
LLM_PROVIDER=groq
GROQ_API_KEY=REEMPLAZAR_POR_TU_API_KEY_DE_GROQ
GROQ_MODEL=openai/gpt-oss-120b

# Para usar OpenAI en modo online:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=REEMPLAZAR_POR_TU_API_KEY_DE_OPENAI
# OPENAI_MODEL=gpt-4o-mini

# Para usar LM Studio en modo local:
# LLM_MODE=local
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=REEMPLAZAR_POR_EL_MODELO_CARGADO
# LLM_API_KEY=lm-studio
